        "commands": {
          "description": "동시에 실행할 명령들",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Stop"
              },
              {
                "$ref": "#/$defs/Move"
              },
              {
                "$ref": "#/$defs/Rotate"
              },
              {
                "$ref": "#/$defs/Formation"
              },
              {
                "$ref": "#/$defs/Gather"
              },
              {
                "$ref": "#/$defs/Follow"
              },
              {
                "$ref": "#/$defs/Dock"
              },
              {
                "$ref": "#/$defs/Undock"
              }
            ]
          },
          "title": "Commands",
          "type": "array"
        }
      },
      "required": [
        "commands"
      ],
      "title": "Step",
      "type": "object"
    },
    "Stop": {
      "additionalProperties": false,
      "properties": {
        "robots": {
          "description": "대상 로봇 ID 목록. 전체를 뜻하면 모든 ID를 적는다",
          "items": {
            "type": "integer"
          },
          "title": "Robots",
          "type": "array"
        },
        "primitive": {
          "const": "stop",
          "title": "Primitive",
          "type": "string"
        }
      },
      "required": [
        "robots",
        "primitive"
      ],
      "title": "Stop",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Version",
          "type": "string"
        },
        "steps": {
          "description": "순서대로 실행할 단계들",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "title": "TaskSpec",
      "type": "object"
    },
    "Undock": {
      "additionalProperties": false,
      "properties": {
        "robots": {
          "description": "대상 로봇 ID 목록. 전체를 뜻하면 모든 ID를 적는다",
          "items": {
            "type": "integer"
          },
          "title": "Robots",
          "type": "array"
        },
        "primitive": {
          "const": "undock",
          "title": "Primitive",
          "type": "string"
        }
      },
      "required": [
        "robots",
        "primitive"
      ],
      "title": "Undock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "LLM 폴백의 출력. 해석할 수 없으면 spec 대신 이유를 돌려준다.",
  "properties": {
    "status": {
      "description": "ok: 해석 성공 / unsupported: 지원하지 않는 동작 / ambiguous: 필수 정보가 빠져 해석 불가",
      "enum": [
        "ok",
        "unsupported",
        "ambiguous"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "description": "status가 ok가 아닐 때 이유 (한국어 한 문장). ok이면 빈 문자열",
      "title": "Reason",
      "type": "string"
    },
    "spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskSpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "status가 ok일 때만 채운다"
    }
  },
  "required": [
    "status",
    "reason",
    "spec"
  ],
  "title": "LLMParse",
  "type": "object"
}